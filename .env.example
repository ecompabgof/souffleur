# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...
DEEPGRAM_API_KEY=...
# Optional: absolute path if ffmpeg is not on PATH when launched from Finder
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# LLM provider: cli (default — your Claude Code subscription via `claude auth login`) or api (needs ANTHROPIC_API_KEY)
LLM_PROVIDER=cli
# CLAUDE_PATH=/Users/you/.local/bin/claude   # if `claude` is not on PATH when launched from Finder

# Speech-to-text tuning (optional; defaults shown)
# STT_MODEL=nova-3
# STT_LANGUAGE=multi          # or a fixed code: en, fr... markedly more accurate on a known-language call
# STT_ENDPOINTING=300         # ms of silence closing a segment; raise to ~800 if speakers get cut off
# STT_UTTERANCE_END=1000      # ms of silence closing a turn
